# Copy this file to .env and fill in. Only TUNNEL_TOKEN is required.
#
# TUNNEL_TOKEN: Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel's token.
# Your domain/hostname is NOT set here: in that tunnel's Public Hostname settings
# (Cloudflare dashboard), point your hostname at: HTTP -> ob-profile-proxy:8080
TUNNEL_TOKEN=

# UPSTREAM: the registration relay your iPhone provider (ValidationRelay app)
# is connected to. Beeper's public relay by default; change this only if you
# self-host your own registration-relay server.
UPSTREAM=https://registration-relay.beeper.com

# Optional: comma-separated relay codes this proxy will serve (others get 403).
# Leave unset to accept any code.
#ALLOWED_CODES=XXXX-XXXX-XXXX-XXXX,YYYY-YYYY-YYYY-YYYY
